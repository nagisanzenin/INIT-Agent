{
 "id": "evo-dbg-vm",
 "title": "Make the Kite interpreter follow its language spec",
 "family": "t",
 "difficulty": 5,
 "labels": [
  "py",
  "debug"
 ],
 "max_turns": 60,
 "prompt": "This directory holds an interpreter for Kite, a small scripting language: a lexer, a parser, a resolver, a compiler to bytecode and a stack VM in kite/, with run.py as the command (`python3 run.py PROGRAM.kite`). It does not behave as SPEC.md describes: some of the example programs in examples/ print the wrong thing (`python3 run_examples.py` runs them all and compares each with its .out file). Fix the implementation so that it follows SPEC.md in every respect; more tests than the visible examples check the whole of SPEC.md. Do not modify SPEC.md, run_examples.py or anything in examples/. Code must run on /usr/bin/python3 (Python 3.9), the interpreter the checks use; standard library only.",
 "source": {
  "kind": "fresh"
 },
 "protected": [
  "SPEC.md",
  "run_examples.py",
  "examples/arith.kite",
  "examples/arith.out",
