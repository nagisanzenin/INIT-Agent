{
 "id": "evo-spec-tmpl",
 "title": "Implement the Stencil template language from its specification",
 "family": "t",
 "difficulty": 5,
 "labels": [
  "py",
  "spec"
 ],
 "max_turns": 60,
 "prompt": "Implement the Stencil template language in the `stencil` package of this workspace; right now it only has stubs. SPEC.md is the contract (rules R1-R64): `stencil.render(template, context)` returns the rendered text and raises `stencil.TemplateError` with exactly the messages and line:column positions SPEC.md gives, and `python3 -m stencil TEMPLATE [CONTEXT]` is the command line (R64). You may add modules inside the package. The visible examples run from the workspace root with `python3 -m unittest discover -s tests`; more tests than the visible ones check every rule of SPEC.md. Do not modify SPEC.md or anything under tests/. Code must run on /usr/bin/python3 (Python 3.9), the interpreter the checks use; standard library only.",
 "source": {
  "kind": "fresh"
 },
