[
 {
  "expect": "[(4, 1)]",
  "expr": "value_counts({'a': 4})",
  "name": "single"
 },
 {
  "expect": "[]",
  "expr": "value_counts({})",
  "name": "empty"
 },
 {
  "expect": "[(0, 5)]",
  "expr": "value_counts({0: 0, 1: 0, 2: 0, 3: 0, 4: 0})",
  "name": "all_same"
 },
 {
  "expect": "[(9, 3), (5, 2)]",
  "expr": "value_counts({'a': 5, 'b': 9, 'c': 9, 'd': 5, 'e': 9})",
  "name": "order_count_desc"
 },
 {
  "expect": "[(10, 1), (20, 1), (30, 1)]",
  "expr": "value_counts({'a': 30, 'b': 10, 'c': 20})",
  "name": "order_ties_by_value"
 },
 {
  "expect": "[(-1, 2), (-20, 1), (0, 1)]",
  "expr": "value_counts({'a': -1, 'b': -1, 'c': -20, 'd': 0})",
  "name": "negative"
 },
 {
  "expect": "[(100, 2), (99, 1), (1000, 1)]",
  "expr": "value_counts({'a': 100, 'b': 1000, 'c': 100, 'd': 99})",
  "name": "large"
 },
 {
  "expect": "[(0, 1), (1, 1)]",
  "expr": "value_counts({'a': True, 'b': 1, 'c': False, 'd': 0})",
  "name": "skip_bool"
 },
 {
  "expect": "[(1, 1)]",
  "expr": "value_counts({'a': 1.0, 'b': '1', 'c': None, 'd': 1, 'e': [1]})",
  "name": "skip_non_int"
 },
 {
  "expect": "[(3, 3), (2, 2)]",
  "expr": "value_counts({'a': 1, 'b': 2, 'c': 2, 'd': 3, 'e': 3, 'f': 3}, min_count=2)",
  "name": "min_count_two"
 },
 {
  "expect": "[]",
  "expr": "value_counts({'a': 1, 'b': 1}, min_count=3)",
  "name": "min_count_high"
 },
 {
  "expect": "[(7, 2)]",
  "expr": "value_counts({'a': 7, 'b': 7, 'c': 8}, 2)",
  "name": "min_count_positional"
 },
 {
  "expr": "value_counts({'a': 1}, min_count=0)",
  "name": "min_count_zero",
  "raises": "ValueError"
 },
 {
  "expr": "value_counts({'a': 1}, -1)",
  "name": "min_count_negative",
  "raises": "ValueError"
 },
 {
  "expect": "['tuple']",
  "expr": "[type(p).__name__ for p in value_counts({'a': 1})]",
  "name": "returns_tuples"
 },
 {
  "expect": "[(-1, 3), (0, 3), (1, 3), (2, 2)]",
  "expr": "value_counts({k: k % 4 - 1 for k in range(11)})",
  "name": "mixed_big"
 },
 {
  "expect": "'3: 2\\n-1: 1'",
  "expr": "format_counts([(3, 2), (-1, 1)])",
  "name": "format_basic"
 },
 {
  "expect": "''",
  "expr": "format_counts([])",
  "name": "format_empty"
 },
 {
  "expect": "'2: 2\\n5: 1'",
  "expr": "format_counts(value_counts({'a': 2, 'b': 2, 'c': 5}))",
  "name": "format_from_counts"
 },
 {
  "expect": "'0: 1'",
  "expr": "format_counts(value_counts({'x': 0}))",
  "name": "format_single"
 }
]
