#!/bin/bash -p
# `init-agent`: open INIT (docs/tui.md §2). Installed by scripts/install.sh into INIT_BIN_DIR (default ~/.local/bin).
# Named `init` before v0.4.1; renamed because `init` shadows /sbin/init on Linux (nagisanzenin/INIT-Agent#1).
#
#   init-agent [args…]       the TUI with these arguments, else `init-root attach [args…]`
#   init-agent --full        full access (ADR-012: the default; ADR-009's flag): passed through to the TUI like every other flag
#   init-agent --workspace   confine this session to the workspace (ADR-012): passed through the same way
#   init-agent --which       print what would run, and run nothing (the launcher's own flag)
#   init-agent upgrade [--version V | --bundle FILE.tar.gz --sha256 HEX] [--allow-unsigned] [--allow-expired] [-- <install.sh args>]
#                            upgrade INIT to the latest release (or release V: 0.5.0 finds the tag v0.5.0-preview; or a
#                            local bundle, with the sha256 the release page lists for it), keeping what it has become:
#                            its body, extensions, sessions, lineage, keys and charter (docs/guide.md "Upgrade"). It runs
#                            the get.sh that install.sh kept in ROOT_HOME/cache/ (the agent cannot write there), which
#                            downloads the bundle, or copies the local one, into ROOT_HOME/cache/upgrade/, checks that
#                            copy's sha256, unpacks it there and runs its install.sh --upgrade (system tools only): stop,
#                            replace, health probe, then commit or roll back. A .sha256 file beside a local bundle is not
#                            used (with full access the agent can write it). From 0.5.3 a download is installed only when
#                            the release's signed SHA256SUMS verifies under the key this install's Root pins (the
#                            --allow-* flags lift that check, and get.sh prints the risk). Run it from your own shell;
#                            inside an INIT session it fails, because the agent can reach none of those paths.
#
# The directory `init-agent` is launched in becomes the agent's workspace (ADR-009): `exec` keeps the cwd, and the TUI
# sends it to the Root, which validates it (launched in ~ or outside the home: no workspace).
#
# The TUI `init-tui` is looked up, in order: $INIT_TUI, `init-tui` next to this launcher, ROOT_HOME/bin/init-tui.
# An $INIT_TUI inside INIT_HOME is refused (exit 77) and any other candidate there is skipped (docs/tui.md T-4: the
# zone can write INIT_HOME, and the agent must never be able to substitute the owner's client). Without a TUI,
# `init-root attach` is the plain owner terminal (root/root.md §3.15): type a line and press Enter; Ctrl-C
# interrupts the current turn, Ctrl-D detaches.
# ROOT_HOME is $INIT_ROOT_HOME, else the value install.sh wrote below, else ~/.init-root; for `upgrade`, only the value
# install.sh wrote (v0.5.4). INIT_HOME is the one ROOT_HOME/install.json names, else $INIT_HOME, else ~/.init.
# bash -p (v0.5.4, the release review): without it bash runs code from the environment before the first line of this
# file: the file BASH_ENV names, SHELLOPTS=xtrace with a PS4 that runs a command, and exported functions (one named
# `exec` replaced the hand-over below). Privileged mode ignores all three; macOS bash 3.2 and bash 5 alike.
# Before it hands over (the TUI, init-root attach, or the kept get.sh), the launcher runs no program found on PATH, only
# bash builtins: with full access the agent can write the owner's PATH directories (ADR-012), and this runs as the owner.
set -euo pipefail
INIT_ROOT_HOME_DEFAULT=""
RH="${INIT_ROOT_HOME:-${INIT_ROOT_HOME_DEFAULT:-$HOME/.init-root}}"
export INIT_ROOT_HOME="$RH"
ROOT_BIN="$RH/bin/init-root"
dir_of() { case "$1" in */*) local d="${1%/*}"; printf '%s\n' "${d:-/}" ;; *) echo . ;; esac; } # dirname, as a builtin
HERE="$(cd "$(dir_of "$0")" && pwd -P)"
IH=""
if [ -r "$RH/install.json" ] && [[ "$(<"$RH/install.json")" =~ \"init_home\":\"([^\"]*)\" ]]; then IH="${BASH_REMATCH[1]}"; fi
IH="${IH:-${INIT_HOME:-$HOME/.init}}"
IH_REAL="$(cd "$IH" 2>/dev/null && pwd -P || echo "$IH")"
# What this prints, it prints as the owner types it in a new terminal (tests/install/test_printed_commands.py): words
# quoted as install.sh's shq quotes them, and INIT_ROOT_HOME= in front when ROOT_HOME is not the passwd home's
# ~/.init-root. The passwd home comes from /usr/bin/python3, as in the other scripts, and only when a message needs it
# (never before a hand-over): no builtin gives it, since bash 5.3 expands `~` to $HOME even with HOME unset.
pw_home() { /usr/bin/python3 -I -c 'import os,pwd;print(pwd.getpwuid(os.getuid()).pw_dir)' 2>/dev/null || true; }
SQ="'\''"
shq() { if [[ -n "$1" && "$1" != *[!A-Za-z0-9/._+,:@%=-]* ]]; then printf '%s' "$1"; else printf "'%s'" "${1//\'/$SQ}"; fi; }
rh_env() { local pw; pw="$(pw_home)"; [ -n "$pw" ] && [ "$RH" = "$pw/.init-root" ] || printf 'INIT_ROOT_HOME=%s ' "$(shq "$RH")"; }
# v0.5.3 (the post-release review of v0.5.2): this command is printed with its path, `~/…` under HOME (install.sh's
# tilde), never as a bare `init-agent`: a fresh Mac's PATH lacks ~/.local/bin. The TUI gets the same path in
# INIT_AGENT_LAUNCHER for the lines it prints (its quit line).
SELF="$HERE/${0##*/}"
tilde() { local h="${HOME%/}"; if [ -n "$h" ] && [[ "$1" == "$h"/?* ]]; then printf '~/%s' "$(shq "${1#"$h"/}")"; else shq "$1"; fi; }
# The upgrade that runs the current get.sh with the system's curl and bash -p (docs/guide.md "Upgrade"; get.sh's up_pipe)
up_pipe() { # [get.sh args]
  printf '/usr/bin/curl -q -fsSL https://github.com/nagisanzenin/INIT-Agent/releases/latest/download/get.sh | %s/bin/bash -p' "$(rh_env)"
  [ $# = 0 ] || printf ' -s -- %s' "$*"
}

inside_init_home() { # <file>: true when its real directory is INIT_HOME or below it
  local d
  d="$(cd "$(dir_of "$1")" 2>/dev/null && pwd -P)" || return 1
  case "$d/" in "$IH_REAL/"*) return 0 ;; *) return 1 ;; esac
}
if [ -n "${INIT_TUI:-}" ] && inside_init_home "$INIT_TUI"; then
  echo "init-agent: refusing INIT_TUI=$INIT_TUI: it lies inside INIT_HOME ($IH), which the agent can write" >&2
  exit 77
fi
TUI=""
for c in "${INIT_TUI:-}" "$HERE/init-tui" "$RH/bin/init-tui"; do
  [ -n "$c" ] && [ -f "$c" ] && [ -x "$c" ] || continue
  inside_init_home "$c" && continue # never run an agent-writable client as the owner
  TUI="$c"; break
done

if [ "${1:-}" = upgrade ]; then
  shift
  # v0.5.4 (the post-release review of v0.5.3): the upgrade replaces the Root, so it takes nothing from the environment,
  # which a full-access agent can set through the owner's shell startup files (docs/release-signing.md A3). Until 0.5.3
  # an INIT_ROOT_HOME there won over the home baked in above, and so ran another home's cache/get.sh, one the agent
  # wrote, which need check nothing; and get.sh got the whole environment (INIT_DIST_URL, INIT_BIN_DIR, …). Now the
  # upgrade uses the baked home only, and get.sh runs under env -i with HOME, that home and the system PATH.
  # INIT_DIST_URL goes too: the installed Root's key decides what installs, but a server of the agent's choosing could
  # still offer a validly signed older release that is newer than this one, or nothing newer, inside its validity (A5).
  # (A copy with no home baked in, the repository's own scripts/init-agent, is never installed as it is; it keeps
  # $INIT_ROOT_HOME, else ~/.init-root.)
  if [ -n "$INIT_ROOT_HOME_DEFAULT" ] && [ "$RH" != "$INIT_ROOT_HOME_DEFAULT" ]; then
    echo "init-agent upgrade: note: INIT_ROOT_HOME=$RH in this shell's environment is ignored; this upgrades the INIT in" >&2
    echo "  $INIT_ROOT_HOME_DEFAULT, the home this launcher was installed for. (If you did not set it, something else did:" >&2
    echo "  look at your shell's startup files.)" >&2
  fi
  RH="${INIT_ROOT_HOME_DEFAULT:-$RH}"
  PATH=/usr/bin:/bin:/usr/sbin:/sbin; export PATH # the upgrade replaces the Root: system tools only (get.sh sets it too)
  GET="$RH/cache/get.sh"
  if [ ! -f "$GET" ] && [ ! -f "$RH/install.json" ]; then
    echo "init-agent: INIT is not installed in $RH (no install.json there), so there is nothing to upgrade. To install it:" >&2
    echo "  $(up_pipe)" >&2
    exit 69
  elif [ ! -f "$GET" ]; then
    echo "init-agent: $GET is missing. An install keeps get.sh there for this command from INIT 0.5.0 on: this install" >&2
    echo "  is 0.4.1, or its copy was removed. Upgrade once with the current get.sh, which keeps a new copy (it refuses a" >&2
    echo "  release before 0.4.1 and prints what to do instead):" >&2
    echo "  $(up_pipe --upgrade)" >&2
    exit 69
  fi
  args=(--upgrade)
  while [ $# -gt 0 ]; do
    case "$1" in
      --bundle) [ $# -ge 2 ] || { echo "init-agent upgrade: --bundle needs a file" >&2; exit 64; }; args+=(--from "$2"); shift 2 ;;
      --sha256|--version) [ $# -ge 2 ] || { echo "init-agent upgrade: $1 needs a value" >&2; exit 64; }; args+=("$1" "$2"); shift 2 ;;
      --) shift; args+=(-- "$@"); break ;;
      --allow-unsigned|--allow-expired) args+=("$1"); shift ;;
      -h|--help) sed -n '9,20p' "$0"; exit 0 ;;
      *) echo "init-agent upgrade: unknown argument $1 (see $(tilde "$SELF") upgrade --help)" >&2; exit 64 ;;
    esac
  done
  exec /usr/bin/env -i HOME="${HOME:-}" INIT_ROOT_HOME="$RH" PATH="$PATH" /bin/sh "$GET" "${args[@]}"
fi
if [ "${1:-}" = --which ]; then
  if [ -n "$TUI" ]; then echo "$TUI"; else echo "$ROOT_BIN attach"; fi
  exit 0
fi
if [ -n "$TUI" ]; then INIT_AGENT_LAUNCHER="$SELF" exec "$TUI" "$@"; fi
if [ ! -x "$ROOT_BIN" ]; then
  echo "init-agent: $ROOT_BIN is missing. Is INIT installed? (scripts/install.sh)" >&2
  exit 69
fi
if [ ! -S "$RH/run/owner.sock" ]; then
  echo "init-agent: the Root is not running ($RH/run/owner.sock is missing)." >&2
  case "$OSTYPE" in # the service install.sh set up: a LaunchAgent on macOS, a systemd user unit on Linux
    darwin*)
      echo "  with the service: launchctl kickstart gui/$UID/dev.init.root" >&2
      PW_HOME="$(pw_home)"
      echo "    (if launchd no longer knows the job: launchctl bootstrap gui/$UID $(shq "${PW_HOME:-$HOME}/Library/LaunchAgents/dev.init.root.plist"))" >&2 ;;
    linux*)
      echo "  with the service: systemctl --user start init-root.service" >&2
      echo "    (if systemd no longer knows the unit: systemctl --user daemon-reload && systemctl --user start init-root.service)" >&2 ;;
  esac
  echo "  without it:       $(rh_env)$(shq "$ROOT_BIN") start --foreground   (in another terminal)" >&2
  exit 69
fi
exec "$ROOT_BIN" attach "$@"
