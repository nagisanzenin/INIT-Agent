#!/usr/bin/env python3
"""e-rs-crypto-square: Exercism `crypto-square` (Rust) with a seeded semantic change (m7-design §3.1.1, E).

Seeded parameters: which characters survive normalization (digits kept or dropped) and their case, the
rectangle shape (wide as in the original, or tall), the padding character (never the original space),
the chunk separator, and at difficulty 4 reversed chunks. Graded cases: 4 visible + 28 hidden `encrypt`
calls, one #[test] each.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "_shared_rs"))
import ersgen  # noqa: E402

s1lib = ersgen.s1lib
CRATE = "crypto_square_variant"
N_HIDDEN = 28
PADS = ["_", "*", ".", "#", "~"]
SEPS = [" ", "-", "|", "/", " / "]
SEP_NAMES = {" ": "a single space", "-": "a hyphen `-`", "|": "a vertical bar `|`", "/": "a slash `/`",
             " / ": "the three characters space, slash, space (` / `)"}
PUNCT = [",", ".", "!", "?", "'", ";", ":", "-", "(", ")", "  ", "\t"]

STUB = '''/// Encodes `input` with the square code of the task.
pub fn encrypt(input: &str) -> String {
    todo!("encrypt {input}")
}
'''


def params(ctx, rng):
    d = ctx.difficulty
    return {
        "digits": rng.chance(1, 2) if d >= 3 else True,
        "upper": rng.chance(1, 2) if d >= 3 else False,
        "tall": rng.chance(1, 2) if d >= 3 else False,
        "pad": rng.choice(PADS),
        "sep": rng.choice(SEPS if d >= 3 else SEPS[1:4]),
        "reverse": d >= 4 and rng.chance(2, 3),
    }


def normalize(text, p):
    out = []
    for c in text:
        if ("a" <= c <= "z") or ("A" <= c <= "Z") or (p["digits"] and "0" <= c <= "9"):
            out.append(c.upper() if p["upper"] else c.lower())
    return "".join(out)


def shape(n, tall):
    big = 0
    while big * big < n:
        big += 1
    small = big - 1 if big * (big - 1) >= n else big
    return (big, small) if tall else (small, big)


def encrypt(text, p):
    t = normalize(text, p)
    if not t:
        return ""
    rows, cols = shape(len(t), p["tall"])
    grid = t + p["pad"] * (rows * cols - len(t))
    chunks = []
    for c in range(cols):
        chunk = "".join(grid[r * cols + c] for r in range(rows))
        chunks.append(chunk[::-1] if p["reverse"] else chunk)
    return p["sep"].join(chunks)


def naive(text):
    return encrypt(text, {"digits": True, "upper": False, "tall": False, "pad": " ", "sep": " ", "reverse": False})


def sample(rng, n_chars):
    """Text whose normalized length is about n_chars: words, digits, punctuation, mixed case."""
    parts, count = [], 0
    while count < n_chars:
        k = min(rng.randint(1, 7), n_chars - count)
        w = rng.word(k, "abcdefghijklmnopqrstuvwxyz")
        if rng.chance(1, 3):
            w = w.capitalize()
        if rng.chance(1, 6):
            w = w.upper()
        parts.append(w)
        count += k
        if rng.chance(1, 5):
            parts.append(str(rng.randint(0, 999)))
        parts.append(rng.choice(PUNCT) + " " if rng.chance(1, 3) else " ")
    return "".join(parts).strip()


def build(ctx):
    rng = ctx.rng()
    p = params(ctx, rng)
    texts = []

    def add(t):
        if t not in texts:
            texts.append(t)

    # visible: one with padding, one exact rectangle, one with digits/punctuation, one short
    add(sample(rng, rng.choice([7, 10, 14, 23])))
    add(sample(rng, rng.choice([6, 12, 20])))
    add("%s, %d %s!" % (rng.word(4).capitalize(), rng.randint(10, 99), rng.word(5)))
    add(rng.word(rng.randint(2, 3)).upper())
    lengths = [1, 2, 3, 5, 8, 9, 11, 15, 16, 17, 21, 25, 26, 30, 35, 36, 41, 48, 50, 56, 63]
    for n in rng.sample(lengths, 15):
        add(sample(rng, n))
    add("")
    add("... --- ... !!")
    add("%d %d-%d" % (rng.randint(100, 999), rng.randint(10, 99), rng.randint(1000, 9999)))
    add("Café crème " + rng.word(5) + " über " + rng.word(3))
    add("  " + rng.word(1).upper() + "  ")
    while len(texts) < N_HIDDEN + 4:
        add(sample(rng, rng.randint(4, 60)))
    vis, rest = texts[:4], rng.shuffled(texts[4:])[:N_HIDDEN]
    order = vis + rest
    if sum(1 for t in order if encrypt(t, p) != naive(t)) < 4:
        raise s1lib.GenError("too few cases separate the mutation from the original")
    cases = []
    for n, t in enumerate(order):
        name = "visible_%d" % (n + 1) if n < 4 else "case_%02d" % (n - 3)
        cases.append((name, "encrypt(%s)" % ersgen.rs_str(t), ersgen.rs_str(encrypt(t, p))))

    keep = "ASCII letters `a`-`z`, `A`-`Z`" + (" and ASCII digits `0`-`9`" if p["digits"] else "")
    case_rule = "upper case" if p["upper"] else "lower case"
    if p["tall"]:
        shape_rule = ("let `r` (rows) be the smallest integer with `r * r >= n`; the number of columns is "
                      "`c = r - 1` if `r * (r - 1) >= n`, otherwise `c = r`. (So there are never fewer rows "
                      "than columns; for n = 8: r = 3, c = 3; for n = 12: r = 4, c = 3.)")
    else:
        shape_rule = ("let `c` (columns) be the smallest integer with `c * c >= n`; the number of rows is "
                      "`r = c - 1` if `c * (c - 1) >= n`, otherwise `r = c`. (So there are never fewer columns "
                      "than rows; for n = 8: c = 3, r = 3; for n = 12: c = 4, r = 3.)")
    read = ("from the bottom row up to the top row" if p["reverse"] else "from the top row down to the bottom row")
    rules = "\n".join([
        "1. Normalize: keep only the %s; drop every other character (spaces, punctuation, non-ASCII letters "
        "such as `é`%s). Convert the kept letters to %s. Let `n` be the length of the normalized text; if "
        "n = 0 the result is the empty string." % (keep, "" if p["digits"] else ", and digits", case_rule),
        "2. Shape: %s" % shape_rule,
        "3. Write the normalized text row by row (left to right, top to bottom) into the `r` x `c` grid. If "
        "the text is shorter than `r * c`, fill the remaining cells at the end of the last row with the "
        "padding character `%s`." % p["pad"],
        "4. Read each column %s to form one chunk of exactly `r` characters. Output the `c` chunks in column "
        "order (leftmost column first), joined by %s (no separator before the first or after the last "
        "chunk)." % (read, SEP_NAMES[p["sep"]]),
    ])
    ref = ersgen.render(ctx.read("ref", "lib.rs"), {
        "KEEP_DIGITS": ersgen.rs_bool(p["digits"]), "UPPER": ersgen.rs_bool(p["upper"]),
        "TALL": ersgen.rs_bool(p["tall"]), "PAD": ersgen.rs_char(p["pad"]), "SEPARATOR": ersgen.rs_str(p["sep"]),
        "REVERSE_CHUNKS": ersgen.rs_bool(p["reverse"])})
    return ersgen.finish(
        ctx, crate=CRATE, api="pub fn encrypt(input: &str) -> String",
        intro="Implement a square code (a classic transposition cipher) with the exact conventions below.",
        rules=rules, stub=STUB, reference=ref, naive=ctx.read("ref", "naive.rs"),
        uses="use %s::encrypt;" % CRATE, cases=cases, n_visible=4)


if __name__ == "__main__":
    s1lib.main(build)
