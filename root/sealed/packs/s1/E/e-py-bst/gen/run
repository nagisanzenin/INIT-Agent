#!/usr/bin/env python3
"""e-py-bst: Exercism `binary-search-tree` with a seeded semantic change (m7-design §3.1.1, family E).

Deltas by difficulty: d2 a seeded ordering of the digit-string values (numeric, mirrored numeric, mirrored
string order, digit sum) and a seeded duplicate policy (left, right, ignore), with sorted_data() and height();
d3 adds levels(); d4 adds path(value) with seeded step letters and ValueError for an absent value.
Reference: ref/solution.py (parameterized by P). Dev fixtures: ref/original.py (string order, equal-or-smaller
goes left, 'L'/'R' paths) and, at d4, naive (the reference with 'L'/'R' path letters).
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "lib"))
import s1lib  # noqa: E402
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "_shared_py"))
from epy import assemble, load_ref, ref_with_params  # noqa: E402,F401

MODULE = "binary_search_tree"
KEYS = ["numeric", "numeric_desc", "text_desc", "digit_sum"]
DUPS = ["left", "right", "ignore"]
STEPS = [["<", ">"], ["0", "1"], ["a", "b"], ["l", "r"], ["-", "+"], ["W", "E"], ["x", "y"]]


def stub(d):
    s = '''class BinarySearchTree:
    def __init__(self, values):
        raise NotImplementedError("BinarySearchTree")

    def sorted_data(self):
        raise NotImplementedError("sorted_data")

    def height(self):
        raise NotImplementedError("height")
'''
    if d >= 3:
        s += '''
    def levels(self):
        raise NotImplementedError("levels")
'''
    if d >= 4:
        s += '''
    def path(self, value):
        raise NotImplementedError("path")
'''
    return s


def outcome(ns, expr):
    """What the check would see for expr against a namespace: ("ok", repr) or ("exc", name)."""
    try:
        return "ok", repr(eval(expr, dict(ns)))  # noqa: S307 - our own expressions against our own code
    except Exception as e:  # noqa: BLE001
        return "exc", type(e).__name__


def cover(ns, exprs, n_visible, rivals, candidate, need=3, cap=40, tries=800):
    """Adds candidate expressions until every rival (the original exercise, or the reference without one
    delta) differs from the reference on >= need hidden cases, so each active delta is exercised."""
    for label, rival in rivals:
        hits = sum(1 for e in exprs[n_visible:] if outcome(ns, e) != outcome(rival, e))
        for _ in range(tries):
            if hits >= need:
                break
            e = candidate(label)
            if e in exprs or outcome(ns, e) == outcome(rival, e):
                continue
            if len(exprs) >= cap:
                raise s1lib.GenError("case cap reached while covering %s" % label)
            exprs.append(e)
            hits += 1
        if hits < need:
            raise s1lib.GenError("could not cover %s" % label)


def params(ctx, rng):
    p = {"key": rng.choice(KEYS), "dup": rng.choice(DUPS), "steps": ["L", "R"]}
    if ctx.difficulty >= 4:
        p["steps"] = list(rng.choice(STEPS))
    return p


def rules_text(p, d):
    key = {
        "numeric": "Values are compared as integers: a value smaller than the node's value goes left, a larger "
                   "one goes right. For example `'9'` goes left of `'10'`, and `'100'` goes right of `'99'`.",
        "numeric_desc": "Values are compared as integers, but the tree is mirrored: a value LARGER than the "
                        "node's value goes left, a smaller one goes right. For example `'10'` goes left of "
                        "`'9'`, and `'99'` goes right of `'100'`.",
        "text_desc": "Values are compared as plain strings, character by character, exactly as Python compares "
                     "`str` (so `'10' < '9'` and `'12' < '123'`), and the tree is mirrored: a value that is "
                     "GREATER as a string goes left, a smaller one goes right. For example `'9'` goes left of "
                     "`'10'`, and `'123'` goes left of `'12'`.",
        "digit_sum": "Values are compared by the sum of their digits; when two digit sums are equal, by their "
                     "integer value. The smaller value goes left, the larger one goes right. For example `'20'` "
                     "(digit sum 2) goes left of `'9'` (digit sum 9), and `'18'` goes left of `'81'` (both have "
                     "digit sum 9, and 18 < 81).",
    }[p["key"]]
    dup = {
        "left": "A value equal to the node's value goes left (it continues into the node's left subtree, where "
                "the normal comparison applies again).",
        "right": "A value equal to the node's value goes right (it continues into the node's right subtree, "
                 "where the normal comparison applies again).",
        "ignore": "A value equal to a value already in the tree is ignored: it is not inserted again and the "
                  "tree does not change.",
    }[p["dup"]]
    order = {"numeric": "ascending numeric order", "numeric_desc": "descending numeric order",
             "text_desc": "descending string order", "digit_sum": "ascending order of (digit sum, integer value)"}
    lines = [
        "**Values.** `BinarySearchTree(values)` receives a list of strings made of decimal digits without "
        "leading zeros (for example `'0'`, `'7'`, `'10'`, `'123'`), possibly with repeated values. It inserts "
        "them one by one, in list order, into an initially empty binary search tree. Two values are equal only "
        "when they are the same string.",
        "",
        "**Ordering.** " + key,
        "",
        "**Duplicates.** " + dup,
        "",
        "**Insertion.** The first value becomes the root. Every later value starts at the root and moves down: "
        "at each node it goes to the left or the right child as decided by the ordering (or the duplicate rule); "
        "when that child is empty, the value becomes that child.",
        "",
        "**sorted_data()** returns all values stored in the tree as a list of `str`, by in-order traversal: the "
        "left subtree, then the node itself, then the right subtree. With this ordering that is %s%s. An empty "
        "tree gives `[]`." % (order[p["key"]], "" if p["dup"] == "ignore" else ", repeated values included"),
        "",
        "**height()** returns the number of levels of the tree as an `int`: `0` for an empty tree, `1` for a "
        "tree with only a root, and in general the number of nodes on the longest path from the root down to a "
        "leaf.",
    ]
    if d >= 3:
        lines += [
            "",
            "**levels()** returns a list of lists of `str`: the list at index i holds the values of all nodes "
            "at depth i (the root has depth 0, its children depth 1, ...), ordered from left to right. An empty "
            "tree gives `[]`.",
        ]
    if d >= 4:
        a, b = p["steps"]
        lines += [
            "",
            "**path(value)** returns a `str` describing the way from the root to the node holding `value`, one "
            "character per step: `%s` for a step to the left child and `%s` for a step to the right child. It "
            "returns `''` when the root holds `value`. The search starts at the root and follows the ordering "
            "(go left when `value` goes left of the node, right when it goes right) and stops at the first node "
            "whose value equals `value`, so for a repeated value it describes the node closest to the root. "
            "It raises `ValueError` when `value` is not in the tree (also for an empty tree)." % (a, b),
        ]
    return "\n".join(lines)


def build(ctx):
    rng = ctx.rng()
    d = ctx.difficulty
    p = params(ctx, rng)
    ref = ref_with_params(ctx, p)
    ns = load_ref(ref)
    orig = ctx.read("ref", "original.py")
    rivals = [("original", load_ref(orig))]
    for k in KEYS:
        if k != p["key"]:
            rivals.append(("key-" + k, load_ref(ref_with_params(ctx, dict(p, key=k)))))
    for dp in DUPS:
        if dp != p["dup"]:
            rivals.append(("dup-" + dp, load_ref(ref_with_params(ctx, dict(p, dup=dp)))))
    dev = {"original": orig}
    if d >= 4:
        dev["naive"] = ref_with_params(ctx, dict(p, steps=["L", "R"]))
        rivals.append(("steps", load_ref(dev["naive"])))
    methods = ["sorted_data", "height"] + (["levels"] if d >= 3 else []) + (["path"] if d >= 4 else [])

    def value():
        k = rng.below(10)
        if k < 4:
            return str(rng.randint(0, 9))
        if k < 8:
            return str(rng.randint(10, 99))
        return str(rng.randint(100, 999))

    def values(lo=3, hi=11, dups=None):
        vals = [value() for _ in range(rng.randint(lo, hi))]
        if dups is None:
            dups = rng.chance(1, 2)
        if dups:
            for _ in range(rng.randint(1, 3)):
                i = rng.below(len(vals))
                j = rng.randint(i + 1, len(vals))
                vals.insert(j, vals[i])
        return vals

    def tree(vals):
        return "BinarySearchTree(%r)" % (vals,)

    def path_case(vals, present=True):
        if present:
            v = rng.choice(vals)
        else:
            v = value()
            while v in vals:
                v = value()
        return "%s.path(%r)" % (tree(vals), v)

    def deep_path(vals):
        """The path case of the deepest node (first occurrence) of vals."""
        best = None
        for v in vals:
            n = len(ns["BinarySearchTree"](vals).path(v))
            if best is None or n > best[0]:
                best = (n, v)
        return "%s.path(%r)" % (tree(vals), best[1])

    exprs = []

    def add(e):
        if e not in exprs:
            exprs.append(e)

    # visible examples: sorted_data, height, levels (d3+) or sorted_data with duplicates, path (d4) or the
    # empty tree, and at d4 an absent value
    add("%s.sorted_data()" % tree(values(6, 8, True)))
    add("%s.height()" % tree(values(6, 8, False)))
    if d >= 3:
        add("%s.levels()" % tree(values(6, 8, True)))
    else:
        add("%s.sorted_data()" % tree(values(5, 7, True)))
    if d >= 4:
        add(deep_path(values(6, 8, False)))
        add(path_case(values(4, 6, False), False))
    else:
        add("BinarySearchTree([]).height()")
    n_visible = len(exprs)
    # hidden: empty and single-node trees
    add("BinarySearchTree([]).sorted_data()")
    single = value()
    add("BinarySearchTree([%r]).height()" % single)
    if d >= 3:
        add("BinarySearchTree([]).levels()")
        add("BinarySearchTree([%r]).levels()" % single)
    if d >= 4:
        add("BinarySearchTree([]).path(%r)" % single)
        add("BinarySearchTree([%r, %r]).path(%r)" % (single, value(), single))
    rep = value()
    add("BinarySearchTree(%r).height()" % ([rep] * rng.randint(3, 4),))
    add("BinarySearchTree(%r).sorted_data()" % ([rep, value(), rep],))
    # hidden: random trees, every method
    for m in methods:
        for _ in range(5 if m != "path" else 3):
            if m == "path":
                add(deep_path(values()))
                add(path_case(values(), rng.chance(3, 4)))
            else:
                add("%s.%s()" % (tree(values()), m))

    def candidate(label):
        m = rng.choice(methods)
        if label.startswith("dup") and m == "sorted_data" and p["dup"] != "ignore" and label != "dup-ignore":
            m = "height"
        vals = values(dups=True if label.startswith("dup") else None)
        if m == "path":
            return path_case(vals, rng.chance(4, 5))
        return "%s.%s()" % (tree(vals), m)

    cover(ns, exprs, n_visible, rivals, candidate)
    while len(exprs) < 28:
        add(candidate("pad"))
    task = ("Implement the class `BinarySearchTree` in `%s.py`: a binary search tree of digit strings with a "
            "seeded ordering." % MODULE)
    return assemble(ctx, MODULE, task, rules_text(p, d), ref, exprs, n_visible, dev, stub(d))


if __name__ == "__main__":
    s1lib.main(build)
