#!/usr/bin/env python3
"""t-merge-rules: merge a feature branch into main and resolve three files by stated rules (family T, pack s1;
INIT licence)."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "_shared"))
import tgen  # noqa: E402

s1lib = tgen.s1lib

# Invented package names; none is a prefix of another, so "sorted by name" has one meaning.
PKGS = ["arborlog", "bollard", "brisket", "capstan", "cinderhttp", "davit", "dovetail", "emberjson", "fairlead",
        "gantry", "gunwale", "halyard", "hawser", "inkwell", "jibsheet", "kestrel-db", "lanyard", "mizzen",
        "nocturne", "oarlock", "pennant", "quoin", "rigger", "sextant-geo", "tackline", "umbra", "vantage-cli",
