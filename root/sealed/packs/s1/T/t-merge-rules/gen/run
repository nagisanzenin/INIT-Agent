    "metrics.port": ["9100", "9101", "9200", "9300", "9400"],
    "net.proxy": ["none", "system", "http://proxy:3128", "http://gw:8080"],
    "pdf.page_size": ["A4", "A5", "letter", "legal"],
    "search.max_hits": ["50", "100", "200", "500", "1000"],
    "tls.min_version": ["1.0", "1.1", "1.2", "1.3"],
    "webhook.timeout_s": ["2", "5", "10", "20", "30"],
    "zone.default": ["utc", "local", "europe", "americas", "asia"],
}

ENTRIES = [
    "Fix a crash when the cache directory is missing", "Add a --dry-run flag to the export command",
    "Speed up report rendering for large tables", "Log the request id on every error line",
    "Retry failed uploads once before giving up", "Show the build date in the about dialog",
    "Accept lower-case country codes in addresses", "Drop the unused legacy XML exporter",
