        "keelson", "lazarette", "marlin-io", "outhaul", "scupper", "thole", "whipstaff"]

# Settings keys and candidate values; no key is a prefix of another.
KEYS = {
    "auth.mode": ["token", "password", "sso", "none", "mtls"],
    "auth.session_ttl": ["900", "1800", "3600", "7200", "14400"],
    "cache.dir": ["/var/cache/app", "/tmp/app-cache", "/srv/cache", "./cache", "/opt/app/cache"],
    "cache.ttl": ["60", "120", "300", "600", "1200"],
    "db.pool_size": ["4", "8", "12", "16", "24"],
    "db.timeout_s": ["5", "10", "15", "30", "45"],
    "export.format": ["csv", "json", "tsv", "ndjson", "xlsx"],
    "http.port": ["8080", "8081", "8443", "9000", "9090"],
    "http.retries": ["0", "1", "2", "3", "5"],
    "log.format": ["text", "json", "logfmt", "compact"],
    "log.level": ["debug", "info", "warn", "error"],
