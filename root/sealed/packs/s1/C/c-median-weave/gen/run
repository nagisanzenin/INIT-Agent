#!/usr/bin/env python3
"""c-median-weave: CRUXEval sample_363 with an order change (family C, operator order; see C/_lib/s1c.py).

The function sorts the numbers, starts from the middle one (or two) and weaves the rest around them. The
seeded change replaces the ascending sort by another ordering.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "_lib"))
import s1c  # noqa: E402

ORIGINAL = (  # verbatim, including the whitespace-only lines
    'def f(nums):\n'
    '    nums.sort()\n'
    '    n = len(nums)\n'
    '    new_nums = [nums[n//2]]\n'
    '    \n'
    '    if n % 2 == 0:\n'
    '        new_nums = [nums[n//2 - 1], nums[n//2]]\n'
    '    \n'
    '    for i in range(0, n//2):\n'
    '        new_nums.insert(0, nums[n-i-1])\n'
    '        new_nums.append(nums[i])\n'
    '    return new_nums\n'
)

HELPER = '''def arrange(nums):
    nums.sort()
'''

CORE = '''from .__HELPER__ import arrange


def __FN__(nums):
    arrange(nums)
    n = len(nums)
    new_nums = [nums[n//2]]

    if n % 2 == 0:
        new_nums = [nums[n//2 - 1], nums[n//2]]

    for i in range(0, n//2):
        new_nums.insert(0, nums[n-i-1])
        new_nums.append(nums[i])
    return new_nums
'''

CRUX_INPUT = [1]

ORDERS = [
    ("from the largest to the smallest", "nums.sort(reverse=True)"),
    ("by absolute value, smallest first; numbers with the same absolute value are ordered by value (the "
     "negative one first)", "nums.sort(key=lambda x: (abs(x), x))"),
    ("by the last decimal digit of their absolute value, smallest digit first; numbers with the same last digit "
     "are ordered by value, smallest first", "nums.sort(key=lambda x: (abs(x) % 10, x))"),
    ("even numbers first, then odd numbers; within each group by value, smallest first",
     "nums.sort(key=lambda x: (x % 2, x))"),
    ("by value, smallest first, except that all negative numbers come after all the other numbers (the "
     "negatives themselves also smallest first)", "nums.sort(key=lambda x: (x < 0, x))"),
]


def variant(rng):
    desc, stmt = rng.choice(ORDERS)
    change = ("Before the weaving, the numbers must now be ordered %s (today: ascending). The weaving itself (the "
              "middle element or elements, then the others placed around them) is unchanged and works on this new "
              "order." % desc)
    return {"change": change, "helper": HELPER.replace("    nums.sort()", "    " + stmt),
            "hint": "only the sorting step needs to change."}


def inputs(rng, state):
    out = [(list(CRUX_INPUT),)]
    for _ in range(300):
        if rng.below(6) == 0:
            xs = s1c.mutate_ints(rng, [3, -1, 12, 7], -15, 25)
        else:
            xs = s1c.rand_ints(rng, -15, 30, 2, 9)
        if xs:
            out.append((xs,))
    return out


def build(ctx):
    return s1c.make(ctx, operator="order", original=ORIGINAL,
                    fn_choices=["weave_middle", "center_out", "median_weave", "fold_around"],
                    params="nums", doc="weaves numbers around their middle element.", core=CORE, helper=HELPER,
                    variant=variant, inputs=inputs, kind="list")


if __name__ == "__main__":
    s1c.s1lib.main(build)
