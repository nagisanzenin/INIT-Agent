#!/usr/bin/env python3
"""c-mark-count: CRUXEval sample_5 with a cond change (family C, operator cond; see C/_lib/s1c.py).

The function replaces every decimal character by `lower` and every other character by `upper`, counting the
replacements equal to 'p' or 'C'. The seeded change swaps the "is decimal" predicate for another character
class, possibly inverted.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "_lib"))
import s1c  # noqa: E402

ORIGINAL = '''def f(text, lower, upper):
    count = 0
    new_text = list()
    for char in text:
        char = lower if char.isdecimal() else upper
        if char in ['p', 'C']:
            count += 1
        new_text.append(char)
    return count, ''.join(new_text)
'''

HELPER = '''MARKERS = ['p', 'C']


def is_low(ch):
    return ch.isdecimal()
'''

CORE = '''from .__HELPER__ import MARKERS, is_low


def __FN__(text, lower, upper):
    count = 0
    new_text = list()
    for char in text:
        char = lower if is_low(char) else upper
        if char in MARKERS:
            count += 1
        new_text.append(char)
    return count, ''.join(new_text)
'''

CRUX_INPUT = ("DSUWeqExTQdCMGpqur", "a", "x")

PREDICATES = [
    ("a vowel, one of `aeiouAEIOU`", "ch in 'aeiouAEIOU'"),
    ("an upper-case ASCII letter `A`-`Z`", "'A' <= ch <= 'Z'"),
    ("an ASCII letter from the first half of the alphabet (`a`-`m` or `A`-`M`)", "ch in 'abcdefghijklmABCDEFGHIJKLM'"),
    ("a decimal digit or a space", "ch.isdecimal() or ch == ' '"),
    ("a punctuation character, one of `.,;:!?-`", "ch in '.,;:!?-'"),
]

TWISTS = [
    ("Finally, the function must return the pair in the other order: `(new_text, count)`.", "(r[1], r[0])"),
    ("Finally, the first element of the returned pair must be `count * 10` instead of `count`.", "(r[0] * 10, r[1])"),
]


def variant(rng):
    desc, expr = rng.choice(PREDICATES)
    invert = rng.chance(1, 3)
    if invert:
        body = "not (%s)" % expr
        change = ("A character must now be replaced by `upper` when it is %s, and by `lower` otherwise (today: "
                  "`lower` for decimal characters and `upper` for all others). The counting of replacements equal "
                  "to `'p'` or `'C'` is unchanged." % desc)
    else:
        body = expr
        change = ("A character must now be replaced by `lower` when it is %s, and by `upper` otherwise (today: "
                  "`lower` for decimal characters and `upper` for all others). The counting of replacements equal "
                  "to `'p'` or `'C'` is unchanged." % desc)
    helper = HELPER.replace("    return ch.isdecimal()", "    return %s" % body)
    return {"change": change, "helper": helper, "hint": "only the character test needs to change."}


SUBS = ["p", "C", "p", "C", "x", "q", "pp", "Cp", "", "c", "P", "1"]


def inputs(rng, state):
    out = [CRUX_INPUT]
    for _ in range(300):
        if rng.below(5) == 0:
            text = s1c.mutate_str(rng, CRUX_INPUT[0], "aeEi1 .Kz")
        else:
            text = s1c.rand_str(rng, "aeiouAEbckmzBKMZ0159 .,!-", 0, 10)
        out.append((text, rng.choice(SUBS), rng.choice(SUBS)))
    return out


def build(ctx):
    return s1c.make(ctx, operator="cond", original=ORIGINAL,
                    fn_choices=["mark_chars", "code_chars", "classify_chars", "mask_text"],
                    params="text, lower, upper", doc="masks the characters of a text by class.", core=CORE,
                    helper=HELPER, variant=variant, inputs=inputs, twists=TWISTS)


if __name__ == "__main__":
    s1c.s1lib.main(build)
