#!/usr/bin/env python3
"""c-classify: CRUXEval sample_369 with a case_add change (family C, operator case_add; see C/_lib/s1c.py).

The function classifies a string as int, float, str, char or tuple through a chain of checks (with quirks:
a single non-space character is "str", a lone space is "char"). The seeded change adds two new classes at
stated positions in the chain.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "_lib"))
import s1c  # noqa: E402

ORIGINAL = '''def f(var):
    if var.isdigit():
        return "int"
    elif var.replace('.', '', 1).isdigit():
        return "float"
    elif var.count(' ') == len(var) - 1:
        return "str"
    elif len(var) == 1:
        return "char"
    else:
        return "tuple"
'''

HELPER = '''INT, FLOAT, STR, CHAR, TUPLE = "int", "float", "str", "char", "tuple"


def digits_only(text):
    return text.isdigit()
'''

CORE = '''from .__HELPER__ import CHAR, FLOAT, INT, STR, TUPLE, digits_only


def __FN__(var):
    if digits_only(var):
        return INT
    elif digits_only(var.replace('.', '', 1)):
        return FLOAT
    elif var.count(' ') == len(var) - 1:
        return STR
    elif len(var) == 1:
        return CHAR
    else:
        return TUPLE
'''

HEXD = "0123456789abcdefABCDEF"
# name: (position, condition source over `var`, result, description)
CASES = {
    "hex": ("first", "var[:2] == '0x' and len(var) > 2 and all(c in %r for c in var[2:])" % HEXD, '"hex"',
            "`var` is `0x` followed by at least one character, all of them hexadecimal digits (`0`-`9`, `a`-`f`, "
            "`A`-`F`): return `\"hex\"`"),
    "neg": ("first", "var[:1] == '-' and (var[1:].isdigit() or var[1:].replace('.', '', 1).isdigit())",
            '"neg-int" if var[1:].isdigit() else "neg-float"',
            "`var` starts with `-` and the rest of it (after that one `-`) would be classified `\"int\"` or "
            "`\"float\"` by the existing int and float checks: return `\"neg-int\"` or `\"neg-float\"` "
            "respectively"),
    "blank": ("first", "var.strip(' ') == ''", '"blank"',
              "`var` is empty or contains only spaces: return `\"blank\"`"),
    "word": ("before_char", "len(var) >= 2 and all(c.isascii() and c.isalpha() for c in var)", '"word"',
             "`var` has at least 2 characters and all of them are ASCII letters: return `\"word\"`"),
    "pair": ("before_tuple", "var.count(',') == 1 and var.split(',')[0] != '' and var.split(',')[1] != ''",
             '"pair"', "`var` contains exactly one comma and the parts before and after it are both non-empty: "
             "return `\"pair\"`"),
}
POSITION_TEXT = {
    "first": "before all the existing checks",
    "before_char": "after the existing `\"str\"` check and before the `\"char\"` check",
    "before_tuple": "after the existing `\"char\"` check, just before the final `\"tuple\"` fallback",
}


def reference(chosen):
    """The core with the new checks inserted at their positions (in the order given)."""
    first = [c for c in chosen if CASES[c][0] == "first"]
    core = CORE
    head = "    if digits_only(var):\n        return INT\n"
    new_head = ""
    for c in first:
        new_head += "    if %s:\n        return %s\n" % (CASES[c][1], CASES[c][2])
    core = core.replace(head, new_head + head)
    for c in chosen:
        pos, cond, res, _ = CASES[c]
        if pos == "before_char":
            core = core.replace("    elif len(var) == 1:\n",
                                "    elif %s:\n        return %s\n    elif len(var) == 1:\n" % (cond, res))
        elif pos == "before_tuple":
            core = core.replace("    else:\n        return TUPLE\n",
                                "    elif %s:\n        return %s\n    else:\n        return TUPLE\n" % (cond, res))
    return core


def variant(rng):
    chosen = rng.sample(sorted(CASES), 2)
    order = sorted(chosen, key=lambda c: ["first", "before_char", "before_tuple"].index(CASES[c][0]))
    lines = []
    for c in order:
        pos = CASES[c][0]
        lines.append("- New check, placed %s: when %s." % (POSITION_TEXT[pos], CASES[c][3]))
    if [CASES[c][0] for c in order] == ["first", "first"]:
        lines.append("- Both new checks come before all the existing ones, in the order listed here.")
    change = ("Add two new classes to the chain of checks. All the existing checks stay as they are, in the same "
              "order.\n" + "\n".join(lines))
    return {"change": change, "core": reference(order), "state": order,
            "hint": "the existing checks run in order and the first one that matches decides; insert the new "
                    "checks at the stated places."}


def sample(rng, cat):
    """A seeded string near the given class (members, near misses and old classes)."""
    r = rng.below(4)
    if cat == "hex":
        body = s1c.rand_str(rng, "0123456789abcdefABCDEF", 1, 5)
        if r == 0:
            body = s1c.mutate_str(rng, body, "gG x.", 1)
        return rng.choice(["0x", "0x", "0x", "0X", "x"]) + body if r != 1 else "0x" + body
    if cat == "neg":
        body = s1c.rand_str(rng, "0123456789", 1, 4)
        if r == 0:
            body = body[:rng.below(len(body) + 1)] + "." + body[rng.below(len(body) + 1):]
        elif r == 1:
            body = s1c.mutate_str(rng, body, "-.a ", 1)
        return "-" + body
    if cat == "blank":
        return " " * rng.randint(0, 5) if r else rng.choice(["\t", " \t", ". ", " _"])
    if cat == "word":
        w = s1c.rand_str(rng, "abcxyzABQZ", 1, 6)
        return s1c.mutate_str(rng, w, "1 !-", 1) if r == 0 else w
    if cat == "pair":
        left = s1c.rand_str(rng, "ab17 ", 0 if r == 0 else 1, 3)
        right = s1c.rand_str(rng, "xy29 ", 0 if r == 1 else 1, 3)
        return left + "," + right + ("," + right if r == 2 and rng.chance(1, 2) else "")
    old = rng.choice(["42", "3.14", ".5", "5.", "1.2.3", "x", " ", "a b", " a", "a  ", "ab cd", "?", "12a", "  q",
                      " 99 777", "7"])
    return s1c.mutate_str(rng, old, "0.9a ", 1) if r == 0 else old


def inputs(rng, state):
    out = [(" 99 777",)]
    pools = list(state) + list(state) + ["old"]
    for _ in range(600):
        out.append((sample(rng, rng.choice(pools)),))
    return out


def build(ctx):
    return s1c.make(ctx, operator="case_add", original=ORIGINAL,
                    fn_choices=["classify", "kind_of", "guess_kind", "label_text"],
                    params="var", doc="guesses what kind of value a string spells.", core=CORE, helper=HELPER,
                    variant=variant, inputs=inputs, kind="str")


if __name__ == "__main__":
    s1c.s1lib.main(build)
