#!/bin/sh
# 10 cases, 100 permille each: line k of cubes.txt must be the k-th expected value.
ok=0
k=1
for want in 1 8 27 64 125 216 343 512 729 1000; do
  got=$(sed -n "${k}p" cubes.txt 2>/dev/null)
  [ "$got" = "$want" ] && ok=$((ok + 1))
  k=$((k + 1))
done
echo "{\"score_permille\":$((ok * 100))}"
