#!/bin/sh
# 10 cases, 100 permille each: line k of triangle.txt must be the k-th expected value.
ok=0
k=1
for want in 1 3 6 10 15 21 28 36 45 55; do
  got=$(sed -n "${k}p" triangle.txt 2>/dev/null)
  [ "$got" = "$want" ] && ok=$((ok + 1))
  k=$((k + 1))
done
echo "{\"score_permille\":$((ok * 100))}"
