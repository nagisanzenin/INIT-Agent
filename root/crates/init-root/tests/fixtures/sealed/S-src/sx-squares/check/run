#!/bin/sh
# 10 cases, 100 permille each: line k of squares.txt must be the k-th expected value.
ok=0
k=1
for want in 1 4 9 16 25 36 49 64 81 100; do
  got=$(sed -n "${k}p" squares.txt 2>/dev/null)
  [ "$got" = "$want" ] && ok=$((ok + 1))
  k=$((k + 1))
done
echo "{\"score_permille\":$((ok * 100))}"
