#!/bin/sh
# 10 cases, 100 permille each: line k of reversed.txt must be the k-th expected value.
ok=0
k=1
for want in juliet india hotel golf foxtrot echo delta charlie bravo alpha; do
  got=$(sed -n "${k}p" reversed.txt 2>/dev/null)
  [ "$got" = "$want" ] && ok=$((ok + 1))
  k=$((k + 1))
done
echo "{\"score_permille\":$((ok * 100))}"
